{
  "info": {
    "name": "Node Blog API - Refresh Rotation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "13.1–13.6 sırasıyla çalıştırılır. base_url, reader_email ve reader_password ortam değişkenlerini kullanır. 13.4 cookie jar kapalıdır ve yalnız rt_first gönderir."
  },
  "item": [
    {
      "name": "13 Refresh Token",
      "item": [
        {
          "name": "13.1 POST login (reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function readRefreshCookie() {",
                  "  const header = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "  const match = header.match(/refresh_token=([^;]*)/);",
                  "  return match ? match[1] : null;",
                  "}",
                  "",
                  "pm.test(\"200 döndü\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const header = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "pm.test(\"cookie httpOnly, SameSite=Strict, Path=/api/v1/auth\", () => {",
                  "  pm.expect(header).to.include(\"HttpOnly\");",
                  "  pm.expect(header).to.include(\"SameSite=Strict\");",
                  "  pm.expect(header).to.include(\"Path=/api/v1/auth\");",
                  "});",
                  "pm.test(\"refresh token gövdede yok\", () => {",
                  "  pm.expect(pm.response.text()).to.not.include(\"refresh_token\");",
                  "});",
                  "pm.collectionVariables.set(\"rt_first\", readRefreshCookie());",
                  "pm.collectionVariables.set(\"rt_access_token\", pm.response.json().data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reader_email}}\",\n  \"password\": \"{{reader_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "13.2 POST refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function readRefreshCookie() {",
                  "  const header = pm.response.headers.get(\"Set-Cookie\") || \"\";",
                  "  const match = header.match(/refresh_token=([^;]*)/);",
                  "  return match ? match[1] : null;",
                  "}",
                  "",
                  "pm.test(\"200 döndü\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const nextCookie = readRefreshCookie();",
                  "pm.test(\"yeni access token geldi\", () => {",
                  "  pm.expect(json.data.access_token).to.not.eql(pm.collectionVariables.get(\"rt_access_token\"));",
                  "});",
                  "pm.test(\"cookie döndü (rotation)\", () => {",
                  "  pm.expect(nextCookie).to.match(/^[A-Za-z0-9_-]{43}$/);",
                  "  pm.expect(nextCookie).to.not.eql(pm.collectionVariables.get(\"rt_first\"));",
                  "});",
                  "pm.collectionVariables.set(\"rt_access_token\", json.data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "13.3 GET me (yenilenen token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 döndü\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"aynı kullanıcı\", () => {",
                  "  pm.expect(pm.response.json().data.email).to.eql(pm.environment.get(\"reader_email\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rt_access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "13.4 POST refresh (eski cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 REFRESH_TOKEN_REUSED\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql(\"REFRESH_TOKEN_REUSED\");",
                  "});",
                  "pm.test(\"cookie silme başlığı geldi\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"Expires=Thu, 01 Jan 1970\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{rt_first}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/refresh"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "13.5 POST refresh (aile iptal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 REFRESH_TOKEN_INVALID\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql(\"REFRESH_TOKEN_INVALID\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "13.6 POST refresh (cookie yok)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 REFRESH_TOKEN_MISSING\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql(\"REFRESH_TOKEN_MISSING\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "rt_first",
      "value": ""
    },
    {
      "key": "rt_access_token",
      "value": ""
    }
  ]
}
